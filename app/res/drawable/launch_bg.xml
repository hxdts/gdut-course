<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图：系统在 Activity 创建之前就画出来，点开图标立刻有画面，不会白屏。
     底层模糊放大版铺满（拉伸看不出来），上层原图左右完整居中。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/launch_bg_blur"
            android:gravity="fill"
            android:filter="true" />
    </item>
    <item android:gravity="center">
        <bitmap
            android:src="@drawable/launch_bg_fg"
            android:gravity="center"
            android:filter="true" />
    </item>
</layer-list>
